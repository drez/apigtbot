Options +FollowSymlinks -SymLinksIfOwnerMatch -Indexes
DirectoryIndex public/index.php
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
<IfModule mod_rewrite.c>
  RewriteEngine on
  # gc-security: never serve build/DB/backup/log/secret artifacts. The
  # front controller below only rewrites when the target does NOT exist
  # (!-f), so any real file under .admin/ (db-backup.sql, build.properties,
  # *.hjson, *.log ...) would be served raw. Forbid the sensitive trees +
  # file types first; -f/-d guards keep virtual app routes untouched.
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule (^|/)(tmp|schema|\.git|\.svn)(/|$) - [F]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule \.(sql|properties|hjson|log|ya?ml|lock|ini|sh|bak|dist|env)$ - [F,NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule (^|/)(composer\.(json|lock)|build\.xml|runtime-conf\.xml|package(-lock)?\.json)$ - [F,NC]

  RewriteCond %{REQUEST_URI} !^/dbg/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !=favicon.ico
  RewriteRule ^([a-zA-Z_.0-9/-]*)$ public/index.php?%{QUERY_STRING} [L]
</IfModule>

<Files ~ "\.xml$">
  Order allow,deny
  Deny from all
</Files>

# --- Static asset delivery (perf) ---------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/rss+xml
</IfModule>

<IfModule mod_headers.c>
  # Build-id-stamped bundles live under css/min/ and js/min/ (filename
  # rotates every build) -> safe to cache immutably for a year. Everything
  # else (individually-served app js/css, images, fonts, service workers
  # that change in place under the same name) gets a short revalidated
  # cache so a deploy is picked up promptly.
  SetEnvIf Request_URI "/(css|js)/min/" GC_IMMUTABLE=1
  <FilesMatch "\.(css|js|woff2?|png|jpe?g|svg|webp|gif|ico)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
    Header set Cache-Control "public, max-age=31536000, immutable" env=GC_IMMUTABLE
  </FilesMatch>
</IfModule>
# ------------------------------------------------------------------------

# gc-security: deny sensitive artifacts even without mod_rewrite.
<FilesMatch "\.(sql|properties|hjson|log|ya?ml|lock|ini|sh|bak|dist)$">
  Order allow,deny
  Deny from all
</FilesMatch>
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|build\.properties)$">
  Order allow,deny
  Deny from all
</FilesMatch>

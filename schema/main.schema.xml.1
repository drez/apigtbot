		<column name="tf" description="Timeframe" type="VARCHAR" size="5" required="true" />
		<column name="price" description="Price" type="DECIMAL" size="18" scale=" 8" required="false" defaultValue="null" />
		<column name="ema20" description="EMA20" type="DECIMAL" size="18" scale=" 8" required="false" defaultValue="null" />
		<column name="ema50" description="EMA50" type="DECIMAL" size="18" scale=" 8" required="false" defaultValue="null" />
		<column name="ema200" description="EMA200" type="DECIMAL" size="18" scale=" 8" required="false" defaultValue="null" />
		<column name="rsi14" description="RSI14" type="DECIMAL" size="9" scale=" 4" required="false" defaultValue="null" />
		<column name="atr14" description="ATR14" type="DECIMAL" size="18" scale=" 8" required="false" defaultValue="null" />
		<column name="atr_pct" description="ATR %" type="DECIMAL" size="9" scale=" 4" required="false" defaultValue="null" />
		<column name="trend" description="Trend" type="ENUM" valueSet="strong_up, up, sideways, down, strong_down" required="false" defaultValue="sideways" />
		<column name="swing_high" description="Swing high" type="DECIMAL" size="18" scale=" 8" required="false" defaultValue="null" />
		<column name="swing_low" description="Swing low" type="DECIMAL" size="18" scale=" 8" required="false" defaultValue="null" />
		<column name="candles_used" description="Candles" type="INTEGER" size="10" defaultValue="0" />
		<column name="recent_candles" description="Candles JSON" type="LONGVARCHAR" required="false" size="1023" />
		<column name="funding_rate" description="Funding rate" type="DECIMAL" size="12" scale=" 8" required="false" defaultValue="null" />
		<column name="depth_imbalance" description="Depth imbalance" type="DECIMAL" size="9" scale=" 4" required="false" defaultValue="null" />

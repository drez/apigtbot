# GoatCheese PRIVATE upload directory (gc-upload-private) - no direct web access.
# Files here are confidential; the only legitimate read path is
# the auth-gated controller (getFileContent), which reads from
# disk and is unaffected by this rule. Deny all HTTP access.
Require all denied
<IfModule mod_php.c>
php_flag engine off
</IfModule>
<IfModule mod_php7.c>
php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar .phps
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar .phps
<FilesMatch "\.(php[0-9]?|phtml|phar|phps)$">
SetHandler none
Require all denied
</FilesMatch>

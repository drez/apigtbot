# ── Project (auto-filled by `gc create`; set manually for Option B installs) ──
MY_BUILDER="GoatCheese_1.1"
MY_DB_HOST="localhost"
MY_DB_NAME="apigtbot"
MY_DB_USER="apigtbot"
MY_DB_PASSWORD="change-me"
MY_PROJECT_ROOT="/var/www/projects"
MY_PROJECT_PATH="/var/www/projects/apigtbot/.admin"
MY_PROJECT_URL="https://your-domain/apigtbot/.admin"
MY_ADMIN_DIR=".admin"
RUN_COMPOSER_ON_BUILD="1"

# ── Admin bootstrap user (installer creates it) ──
APP_USER="apigoat"
APP_PASSWORD="change-me"

# ── Secrets (generate your own; never commit real values) ──
JWT_SECRET=""
OAUTH_ENCRYPTION_KEY=""
OAUTH_PRIVATE_KEY=""
OAUTH_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ── Bot safety model (see README) ──
GTBOT_DRY_RUN="1"
GTBOT_USE_TESTNET="1"
GTBOT_API_KEY=""
GTBOT_API_SECRET=""
GTBOT_API_PRIVATE_KEY=""
GTBOT_TELEGRAM_BOT_TOKEN=""
GTBOT_TELEGRAM_CHAT_ID=""
GTBOT_HEARTBEAT_STALE="30"

# ── Remote deploy via `gc deploy` (optional) ──
DEPLOY_HOST=""
DEPLOY_USER=""
DEPLOY_PASSWORD=""
DEPLOY_SSH_PORT="22"
DEPLOY_PATH=""
DEPLOY_PHP="php8.4"
DEPLOY_PUBLIC_URL=""
DEPLOY_DB_HOST="localhost"
DEPLOY_DB_PORT="3306"
DEPLOY_DB_NAME=""
DEPLOY_DB_USER=""
DEPLOY_DB_PASSWORD=""
DEPLOY_PUSH_ENV="GTBOT_USE_TESTNET,GTBOT_DRY_RUN,GTBOT_TELEGRAM_BOT_TOKEN,GTBOT_TELEGRAM_CHAT_ID,GTBOT_HEARTBEAT_STALE"

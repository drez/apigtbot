		<column name="adx14" description="ADX14" type="DECIMAL" size="9" scale=" 4" required="false" defaultValue="null" />
		<column name="atr_pct_rank" description="ATR% percentile" type="DECIMAL" size="9" scale=" 4" required="false" defaultValue="null" />
		<column name="taker_buy_ratio" description="Taker buy ratio" type="DECIMAL" size="9" scale=" 4" required="false" defaultValue="null" />
		<column name="vol_zscore" description="Volume z-score" type="DECIMAL" size="9" scale=" 4" required="false" defaultValue="null" />

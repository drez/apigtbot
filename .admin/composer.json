{
    "name": "apigoat/apigtbot",
    "type": "project",
    "description": "base admin interface",
    "autoload": {
        "psr-4": {
            "ApiGoat\\": "vendor/apigoat/runtime/src",
            "App\\Domains\\": "src/App/Domains",
            "App\\Mcp\\": "src/App/Mcp",
            "App\\om\\": "src/App/Models/Built/om",
            "App\\": [
                "src/App/Models/Built",
                "src/App/Interfaces",
                "src/App/Interfaces/Built",
                "src/App/Services",
                "src/App/Services/Built"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "vendor-dir": "vendor",
        "audit": {
            "ignore": {
                "PKSA-sd3x-9jwt-jn4s": "CKEditor 4 EOL - accepted risk, pinned 4.22.1",
                "PKSA-4d16-gn5t-2wt7": "CKEditor 4 EOL - accepted risk, pinned 4.22.1"
            }
        }
    },
    "require": {
        "php": ">=8",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-xml": "*",
        "ext-bcmath": "*",
        "slim/slim": "^4.0",
        "php-di/slim-bridge": "^3.0",
        "php-di/php-di": "^6.0",
        "respect/validation": "2.4.10 as dev-main",
        "ckeditor/ckeditor5-self-hosted": "*",
        "slim/psr7": "^1.0",
        "symfony/filesystem": "^5.0",
        "apigoat/runtime": "dev-master",
        "propel/propel1": "dev-master",
        "apigoat/phing-copy2": "dev-master",
        "peppeocchi/php-cron-scheduler": "dev-master",
        "adhocore/env": "^0.1.0",
        "thingengineer/mysqli-database-class": "dev-master",
        "minishlink/web-push": "^9.0",
        "league/oauth2-server": "^8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brianium/paratest": "^7.4"
    },
    "repositories": [
        {
            "comment": "CKEditor 5 self-hosted browser bundle (not on Packagist). composer update (run on every gc build) fetches this exact version's ZIP from the CDN into vendor/ckeditor/ckeditor5-self-hosted/ckeditor5/. To update CKEditor 5: bump the version AND the version in the dist url below.",
            "type": "package",
            "package": {
                "name": "ckeditor/ckeditor5-self-hosted",
                "version": "48.2.0",
                "dist": {
                    "type": "zip",
                    "url": "https://cdn.ckeditor.com/ckeditor5/48.2.0/zip/ckeditor5-48.2.0.zip"
                }
            }
        },
        {
            "type": "git",
            "url": "https://github.com/drez/APIgoat-Propel1.git"
        },
        {
            "type": "git",
            "url": "https://github.com/drez/APIgoat-runtime.git"
        },
        {
            "type": "git",
            "url": "https://github.com/drez/conditional-middleware"
        },
        {
            "type": "git",
            "url": "https://github.com/drez/APIgoat-phing-copy.git"
        }
    ],
    "minimum-stability": "dev"
}
